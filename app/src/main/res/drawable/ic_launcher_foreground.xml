<!-- Primo piano dell'icona adattiva: autobus bianco con antenna e onde GPS.
     Le finestre sono in tinta teal per simulare i vetri "ritagliati" sullo
     sfondo. Tutto e' entro la "safe zone" centrale (18..90). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ruote (grigio scuro) -->
    <path android:fillColor="#263238"
        android:pathData="M35,75 a5,5 0 1 0 10,0 a5,5 0 1 0 -10,0 z" />
    <path android:fillColor="#263238"
        android:pathData="M63,75 a5,5 0 1 0 10,0 a5,5 0 1 0 -10,0 z" />

    <!-- Carrozzeria dell'autobus (bianca) -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M32,52 h44 a5,5 0 0 1 5,5 v13 a5,5 0 0 1 -5,5 h-44 a5,5 0 0 1 -5,-5 v-13 a5,5 0 0 1 5,-5 z" />

    <!-- Finestrini (teal = colore dello sfondo) -->
    <path android:fillColor="#00796B" android:pathData="M35,56 h9 v7 h-9 z" />
    <path android:fillColor="#00796B" android:pathData="M47,56 h9 v7 h-9 z" />
    <path android:fillColor="#00796B" android:pathData="M59,56 h9 v7 h-9 z" />
    <path android:fillColor="#00796B" android:pathData="M71,56 h5 v7 h-5 z" />

    <!-- Antenna (bianca) -->
    <path android:fillColor="#FFFFFF" android:pathData="M53,40 h2 v12 h-2 z" />

    <!-- Onde GPS (verdi) -->
    <path android:strokeColor="#B2FF59" android:strokeWidth="2" android:strokeLineCap="round"
        android:fillColor="#00000000" android:pathData="M58,34 Q62,38 58,42" />
    <path android:strokeColor="#B2FF59" android:strokeWidth="2" android:strokeLineCap="round"
        android:fillColor="#00000000" android:pathData="M61,31 Q68,38 61,45" />
    <path android:strokeColor="#B2FF59" android:strokeWidth="2" android:strokeLineCap="round"
        android:fillColor="#00000000" android:pathData="M50,34 Q46,38 50,42" />
    <path android:strokeColor="#B2FF59" android:strokeWidth="2" android:strokeLineCap="round"
        android:fillColor="#00000000" android:pathData="M47,31 Q40,38 47,45" />

    <!-- Punto sorgente del segnale GPS (verde) -->
    <path android:fillColor="#B2FF59"
        android:pathData="M51,38 a3,3 0 1 0 6,0 a3,3 0 1 0 -6,0 z" />
</vector>
